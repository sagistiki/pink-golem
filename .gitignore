# Minecraft server (created by pinkgolem.py setup) — keep only the README
server/*
!server/README.md
backups/
dist/
# runtime data written by the tools
data/*
!data/README.md
jobs/*
!jobs/README.md
# local config (contains the RCON password path, bot name…) and client configs
pinkgolem.json
clawdblock.json
.mcp.json
.claude/
# tooling
node_modules/
__pycache__/
*.pyc
.DS_Store
*.log

# mods built from mods-src/
mods-src/*/build/
# generated texture folders (the zips are kept)
resourcepacks/textures/natural_*/

# Pink Golem Bench: raw runs (transcripts with local paths), state and logs stay local; charts + results.md are published
bench/.venv/
bench/state/
bench/logs/
bench/results/*
!bench/results/charts/
!bench/results/leaderboard.json
